---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/site";

export interface Props {
  title?: string;
  description?: string;
  /** Set on the home page so the header can skip the site-name link. */
  hideHeaderName?: boolean;
}

const { title, description = site.metaDescription, hideHeaderName = false } =
  Astro.props;

const pageTitle = title ? `${title} · ${site.name}` : `${site.name} — ${site.degree}`;
const canonical = new URL(Astro.url.pathname, Astro.url.origin).href;
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="author" content={site.fullName} />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:image" content={new URL("/og.svg", Astro.site ?? Astro.url.origin).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name} — ${site.degree}`} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL("/og.svg", Astro.site ?? Astro.url.origin).href} />

    <meta
      name="theme-color"
      content={site.themeColorLight}
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content={site.themeColorDark}
      media="(prefers-color-scheme: dark)"
    />

    <script is:inline>
      // Applied before first paint so the page never flashes the wrong theme.
      (function () {
        var root = document.documentElement;
        root.classList.remove("no-js");
        try {
          var stored = localStorage.getItem("theme");
          var prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
          var dark = stored ? stored === "dark" : prefersDark;
          root.classList.toggle("dark", dark);
        } catch (e) {
          /* private mode: fall back to the light default already in CSS */
        }
      })();
    </script>
  </head>
  <body class="min-h-dvh flex flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded focus:bg-[var(--bg-elevated)] focus:px-4 focus:py-2 focus:text-sm focus:shadow-lg"
    >
      Skip to content
    </a>
    <Header hideName={hideHeaderName} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
