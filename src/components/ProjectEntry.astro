---
import type { Project } from "../data/projects";

export interface Props {
  project: Project;
}

const { project } = Astro.props;

const linkEntries = [
  project.links.repo && { label: "Source", href: project.links.repo },
  project.links.demo && { label: "Demo", href: project.links.demo },
  project.links.writeup && { label: "Write-up", href: project.links.writeup },
].filter(Boolean) as Array<{ label: string; href: string }>;
---

<article
  id={project.title.toLowerCase().replace(/[^a-z0-9]+/g, "-")}
  class="scroll-mt-24"
>
  <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
    <h2 class="text-xl font-medium tracking-tight">{project.title}</h2>
    <span class="faint font-mono text-xs">{project.year}</span>
  </div>

  {
    project.subtitle && (
      <p class="muted mt-1 text-sm">{project.subtitle}</p>
    )
  }

  <p class="mt-3 max-w-prose text-sm leading-relaxed">{project.blurb}</p>

  {
    project.image && (
      <img
        src={project.image}
        alt={`Screenshot of ${project.title}`}
        loading="lazy"
        decoding="async"
        class="mt-5 w-full rounded-lg border rule"
        width="1200"
        height="630"
      />
    )
  }

  {
    project.metrics && project.metrics.length > 0 && (
      <dl class="mt-6 grid grid-cols-2 gap-4 rounded-lg border rule bg-[var(--bg-elevated)] p-5 sm:grid-cols-3">
        {project.metrics.map((metric) => (
          <div>
            <dd class="font-mono text-2xl tracking-tight">{metric.value}</dd>
            <dt class="faint mt-1 text-xs">{metric.label}</dt>
          </div>
        ))}
      </dl>
    )
  }

  {
    linkEntries.length > 0 && (
      <ul class="mt-5 flex flex-wrap gap-x-5 gap-y-2">
        {linkEntries.map((link) => (
          <li>
            <a
              href={link.href}
              class="link text-sm"
              target="_blank"
              rel="noopener noreferrer"
            >
              {link.label} ↗
            </a>
          </li>
        ))}
      </ul>
    )
  }

  {
    project.tags.length > 0 && (
      <ul class="mt-4 flex flex-wrap gap-1.5">
        {project.tags.map((tag) => (
          <li class="tag">{tag}</li>
        ))}
      </ul>
    )
  }
</article>
