---
export interface Props {
  id?: string;
  /** Small monospace label above the heading, e.g. "01 / Work". */
  eyebrow?: string;
  title: string;
  /** Right-aligned link rendered in the section header, e.g. "All projects". */
  action?: { href: string; label: string };
  class?: string;
}

const { id, eyebrow, title, action, class: className = "" } = Astro.props;
---

<section id={id} class:list={["scroll-mt-24", className]}>
  <div
    class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 border-b rule pb-4"
  >
    <div class="flex items-baseline gap-4">
      {
        eyebrow && (
          <span class="font-mono text-xs text-[var(--fg-faint)]">{eyebrow}</span>
        )
      }
      <h2 class="text-2xl font-medium tracking-tight">{title}</h2>
    </div>
    {
      action && (
        <a
          href={action.href}
          class="muted text-sm transition-colors hover:text-[var(--fg)]"
        >
          {action.label} →
        </a>
      )
    }
  </div>
  <div class="mt-8">
    <slot />
  </div>
</section>
