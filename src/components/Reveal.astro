---
/**
 * Wraps content in a fade/rise on first scroll into view.
 * The observer script is defined once per page, and it marks elements
 * visible immediately if the user prefers reduced motion.
 */
export interface Props {
  /** Stagger in milliseconds, for items in a list. */
  delay?: number;
  as?: "div" | "li" | "article" | "section";
  class?: string;
}

const { delay = 0, as: Tag = "div", class: className } = Astro.props;
---

<Tag
  class:list={["reveal", className]}
  data-reveal={delay ? String(delay) : undefined}
>
  <slot />
</Tag>

<script>
  function initReveal() {
    const targets = document.querySelectorAll<HTMLElement>("[data-reveal]");
    if (targets.length === 0) return;

    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
    if (reduce.matches || !("IntersectionObserver" in window)) {
      targets.forEach((el) => el.classList.add("is-visible"));
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const el = entry.target as HTMLElement;
          const delay = Number(el.dataset.reveal ?? 0);
          window.setTimeout(() => el.classList.add("is-visible"), delay);
          observer.unobserve(el);
        }
      },
      { rootMargin: "0px 0px -10% 0px", threshold: 0.05 },
    );

    targets.forEach((el) => observer.observe(el));
  }

  initReveal();
  // Client-side navigation re-runs page scripts.
  document.addEventListener("astro:page-load", initReveal);
</script>
