---
import { experience } from "../data/experience";

const entries = experience;
---

<ol class="space-y-8">
  {
    entries.map((entry) => (
      <li class="grid gap-2 md:grid-cols-[11rem_1fr] md:gap-8">
        <div class="flex items-baseline gap-3 md:block">
          <p class="font-mono text-xs text-[var(--fg-faint)]">{entry.period}</p>
          {entry.location && (
            <p class="faint text-xs md:mt-1">{entry.location}</p>
          )}
        </div>

        <div>
          <h3 class="text-base font-medium tracking-tight">
            {entry.role}
            <span class="muted font-normal"> · {entry.org}</span>
          </h3>
          <ul class="mt-2 space-y-1.5">
            {entry.points.map((point) => (
              <li class="muted flex gap-3 text-sm leading-relaxed">
                <span aria-hidden="true" class="faint select-none">
                  —
                </span>
                <span>{point}</span>
              </li>
            ))}
          </ul>
          {entry.links && entry.links.length > 0 && (
            <ul class="mt-3 flex flex-wrap gap-4">
              {entry.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="link text-sm"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {link.label} ↗
                  </a>
                </li>
              ))}
            </ul>
          )}
        </div>
      </li>
    ))
  }
</ol>
