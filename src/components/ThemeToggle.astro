---
/**
 * Cycles system → light → dark → system and persists the choice.
 * The initial class is applied by the inline script in BaseLayout, so this
 * component only needs to read the current state and reflect it.
 */
---

<button
  type="button"
  data-theme-toggle
  class="rounded p-2 transition-colors hover:bg-[var(--bg-elevated)]"
  aria-label="Toggle color theme"
  title="Toggle color theme"
>
  <svg
    data-icon="light"
    class="hidden h-4 w-4 dark:block"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path
      d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
    ></path>
  </svg>

  <svg
    data-icon="dark"
    class="hidden h-4 w-4 dark:hidden"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
  </svg>
</button>

<script>
  const STORAGE_KEY = "theme";

  function apply(pref: "system" | "light" | "dark") {
    const dark =
      pref === "dark" ||
      (pref === "system" &&
        window.matchMedia("(prefers-color-scheme: dark)").matches);
    document.documentElement.classList.toggle("dark", dark);
  }

  function currentPref(): "system" | "light" | "dark" {
    return (
      (localStorage.getItem(STORAGE_KEY) as "system" | "light" | "dark") ||
      "system"
    );
  }

  document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]").forEach(
    (button) => {
      button.addEventListener("click", () => {
        const order: Array<"system" | "light" | "dark"> = [
          "system",
          "light",
          "dark",
        ];
        const next = order[(order.indexOf(currentPref()) + 1) % order.length];
        localStorage.setItem(STORAGE_KEY, next);
        apply(next);
        button.setAttribute(
          "title",
          next === "system" ? "Theme: system" : `Theme: ${next}`,
        );
      });
      const pref = currentPref();
      button.setAttribute(
        "title",
        pref === "system" ? "Theme: system" : `Theme: ${pref}`,
      );
    },
  );

  // Follow the OS when the user has not made an explicit choice.
  window
    .matchMedia("(prefers-color-scheme: dark)")
    .addEventListener("change", () => {
      if (currentPref() === "system") apply("system");
    });
</script>
