---
import type { Project } from "../data/projects";

export interface Props {
  project: Project;
}

const { project } = Astro.props;
const { title, subtitle, blurb, year, tags, links, image, metrics } = project;

const linkEntries = [
  links.repo && { label: "Source", href: links.repo },
  links.demo && { label: "Demo", href: links.demo },
  links.writeup && { label: "Write-up", href: links.writeup },
].filter(Boolean) as Array<{ label: string; href: string }>;
---

<article
  class="group relative flex flex-col rounded-lg border rule bg-[var(--bg-elevated)] p-5 transition-colors hover:border-[var(--border-strong)] sm:p-6"
>
  <div class="flex items-baseline justify-between gap-4">
    <h3 class="text-lg font-medium tracking-tight">
      {title}
      {
        subtitle && (
          <span class="muted font-normal"> · {subtitle}</span>
        )
      }
    </h3>
    <span class="faint shrink-0 font-mono text-xs">{year}</span>
  </div>

  <p class="muted mt-2 text-sm leading-relaxed">{blurb}</p>

  {
    image && (
      <img
        src={image}
        alt={`Screenshot of ${title}`}
        loading="lazy"
        decoding="async"
        class="mt-5 w-full rounded border rule"
        width="1200"
        height="630"
      />
    )
  }

  {
    metrics && metrics.length > 0 && (
      <dl class="mt-5 grid grid-cols-2 gap-4 border-t rule pt-4">
        {metrics.map((metric) => (
          <div>
            <dt class="faint text-xs">{metric.label}</dt>
            <dd class="mt-0.5 font-mono text-lg tracking-tight">
              {metric.value}
            </dd>
          </div>
        ))}
      </dl>
    )
  }

  <div class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-2">
    {linkEntries.map((link) => (
      <a
        href={link.href}
        class="text-sm font-medium underline decoration-[var(--border-strong)] underline-offset-4 transition-colors hover:text-[var(--color-accent)] hover:decoration-[var(--color-accent)]"
        target="_blank"
        rel="noopener noreferrer"
      >
        {link.label} ↗
      </a>
    ))}
    {linkEntries.length === 0 && (
      <span class="faint text-sm">Details coming soon</span>
    )}
  </div>

  {
    tags.length > 0 && (
      <ul class="mt-4 flex flex-wrap gap-1.5">
        {tags.map((tag) => (
          <li class="tag">{tag}</li>
        ))}
      </ul>
    )
  }

</article>
